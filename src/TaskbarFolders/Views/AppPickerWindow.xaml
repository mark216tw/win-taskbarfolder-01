<Window x:Class="Mark.TaskbarFolders.Views.AppPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:Mark.TaskbarFolders.Resources"
        Title="{res:Loc PickAppsTitle}"
        Width="620"
        Height="580"
        MinWidth="480"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextBrush}"
        Icon="pack://application:,,,/TaskbarFolders;component/Resources/app.ico">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="{res:Loc PickAppsTitle}"
                   Style="{StaticResource HeadingTextStyle}"
                   Margin="0,0,0,8" />

        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Border CornerRadius="8"
                    Background="{DynamicResource SearchBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" />
            <TextBlock x:Name="SearchPlaceholder"
                       Text="{res:Loc SearchAppsPlaceholder}"
                       Foreground="{DynamicResource SubtleTextBrush}"
                       IsHitTestVisible="False"
                       Margin="11,0,0,0"
                       VerticalAlignment="Center"
                       FontSize="13" />
            <TextBox x:Name="SearchBox"
                     TextChanged="OnSearchChanged"
                     Background="Transparent"
                     BorderBrush="Transparent" />
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Padding="6">
            <ListBox x:Name="AppList"
                     SelectionMode="Extended"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="{Binding Name}"
                                       TextTrimming="CharacterEllipsis"
                                       TextWrapping="NoWrap" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding Category}"
                                       Style="{StaticResource SubtleTextStyle}"
                                       Margin="12,0,0,0"
                                       TextWrapping="NoWrap" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    Margin="0,8,0,0">
            <Button Content="{res:Loc SelectAll}"
                    Click="OnSelectAll"
                    Margin="0,0,8,0" />
            <Button Content="{res:Loc ClearSelection}"
                    Click="OnClearSelection" />
            <TextBlock Text="{res:Loc AppPickerHint}"
                       Style="{StaticResource SubtleTextStyle}"
                       VerticalAlignment="Center"
                       Margin="16,0,0,0" />
        </StackPanel>

        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button Content="{res:Loc Cancel}"
                    Click="OnCancel"
                    Margin="0,0,8,0" />
            <Button Content="{res:Loc Ok}"
                    Style="{StaticResource AccentButtonStyle}"
                    Click="OnOk"
                    IsDefault="True" />
        </StackPanel>
    </Grid>
</Window>
