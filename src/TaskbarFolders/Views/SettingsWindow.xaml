<Window x:Class="Mark.TaskbarFolders.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:Mark.TaskbarFolders.Resources"
        Title="{res:Loc SettingsTitle}"
        Width="460"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextBrush}"
        Icon="pack://application:,,,/TaskbarFolders;component/Resources/app.ico">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="{res:Loc SettingsTitle}"
                   Style="{StaticResource HeadingTextStyle}"
                   Margin="0,0,0,12" />

        <Border Grid.Row="1"
                Style="{StaticResource CardBorderStyle}"
                Padding="16">
            <StackPanel>
                <TextBlock Text="{res:Loc Theme}"
                           Style="{StaticResource SubtleTextStyle}"
                           Margin="0,0,0,6" />
                <ComboBox SelectedValue="{Binding ThemeMode, Mode=TwoWay}"
                          SelectedValuePath="Tag">
                    <ComboBoxItem Content="{res:Loc ThemeSystem}" Tag="System" Foreground="{DynamicResource TextBrush}" />
                    <ComboBoxItem Content="{res:Loc ThemeLight}" Tag="Light" Foreground="{DynamicResource TextBrush}" />
                    <ComboBoxItem Content="{res:Loc ThemeDark}" Tag="Dark" Foreground="{DynamicResource TextBrush}" />
                </ComboBox>
                <TextBlock Text="{res:Loc EditorThemeHint}"
                           Style="{StaticResource SubtleTextStyle}"
                           Margin="0,8,0,0" />
            </StackPanel>
        </Border>

        <Border Grid.Row="2"
                Style="{StaticResource CardBorderStyle}"
                Padding="16"
                Margin="0,12,0,0">
            <StackPanel>
                <TextBlock Text="{res:Loc SettingsGroupsSection}"
                           Style="{StaticResource SubtleTextStyle}"
                           Margin="0,0,0,6" />
                <TextBlock Text="{res:Loc SettingsGroupsHint}" />
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Button Content="{res:Loc ExportGroups}"
                            Command="{Binding ExportGroupsCommand}"
                            AutomationProperties.Name="{res:Loc ExportGroups}"
                            Margin="0,0,8,0" />
                    <Button Content="{res:Loc ImportGroups}"
                            Command="{Binding ImportGroupsCommand}"
                            AutomationProperties.Name="{res:Loc ImportGroups}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="3"
                Style="{StaticResource CardBorderStyle}"
                Padding="16"
                Margin="0,12,0,0">
            <StackPanel>
                <TextBlock Text="{res:Loc AboutSection}"
                           Style="{StaticResource SubtleTextStyle}"
                           Margin="0,0,0,6" />
                <TextBlock Text="{res:Loc AppTitle}"
                           FontWeight="SemiBold" />
                <TextBlock Text="{res:Loc AboutDescription}"
                           Style="{StaticResource SubtleTextStyle}"
                           Margin="0,2,0,0" />
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Grid.Column="0"
                               Text="{res:Loc AboutVersionLabel}"
                               Style="{StaticResource SubtleTextStyle}"
                               Margin="0,0,12,4" />
                    <TextBlock Grid.Row="0"
                               Grid.Column="1"
                               Text="{Binding AppVersion}"
                               Margin="0,0,0,4" />
                    <TextBlock Grid.Row="1"
                               Grid.Column="0"
                               Text="{res:Loc AboutFileVersionLabel}"
                               Style="{StaticResource SubtleTextStyle}"
                               Margin="0,0,12,4" />
                    <TextBlock Grid.Row="1"
                               Grid.Column="1"
                               Text="{Binding AppFileVersion}"
                               Margin="0,0,0,4" />
                    <TextBlock Grid.Row="2"
                               Grid.Column="0"
                               Text="{res:Loc AboutLicenseLabel}"
                               Style="{StaticResource SubtleTextStyle}"
                               Margin="0,0,12,4" />
                    <TextBlock Grid.Row="2"
                               Grid.Column="1"
                               Text="{res:Loc AboutLicenseValue}"
                               Margin="0,0,0,4" />
                    <TextBlock Grid.Row="3"
                               Grid.Column="0"
                               Text="{res:Loc AboutCopyrightLabel}"
                               Style="{StaticResource SubtleTextStyle}"
                               Margin="0,0,12,0" />
                    <TextBlock Grid.Row="3"
                               Grid.Column="1"
                               Text="{Binding AppCopyright}" />
                </Grid>
                <TextBlock Text="{res:Loc AboutPrivacyHint}"
                           Style="{StaticResource SubtleTextStyle}"
                           Margin="0,10,0,0" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Content="{res:Loc Close}"
                    Click="OnClose"
                    IsCancel="True"
                    Margin="0,0,8,0" />
            <Button Content="{res:Loc Save}"
                    Style="{StaticResource AccentButtonStyle}"
                    IsEnabled="{Binding HasUnsavedSettingsChanges}"
                    Click="OnSave"
                    IsDefault="True" />
        </StackPanel>
    </Grid>
</Window>
