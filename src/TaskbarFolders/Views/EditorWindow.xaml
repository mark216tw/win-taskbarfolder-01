<Window x:Class="Mark.TaskbarFolders.Views.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:Mark.TaskbarFolders.Resources"
        Title="{res:Loc EditorTitle}"
        Width="980"
        Height="680"
        MinWidth="820"
        MinHeight="560"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextBrush}"
        Icon="pack://application:,,,/TaskbarFolders;component/Resources/app.ico">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="{res:Loc EditorHeading}" Style="{StaticResource HeadingTextStyle}" />
                <TextBlock Text="{res:Loc EditorSubtitle}"
                           Style="{StaticResource SubtleTextStyle}"
                           Margin="0,4,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <Button Content="{res:Loc Save}"
                        Command="{Binding SaveCommand}"
                        Style="{StaticResource AccentButtonStyle}" />
                <Button Content="{res:Loc GenerateShortcut}"
                        Command="{Binding GenerateShortcutCommand}"
                        Margin="8,0,0,0" />
                <Button Content="⋯"
                        Click="OnOpenSettings"
                        ToolTip="{res:Loc SettingsTitle}"
                        AutomationProperties.Name="{res:Loc SettingsTitle}"
                        Width="40"
                        Height="32"
                        Padding="0"
                        FontSize="18"
                        Margin="8,0,0,0" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="{res:Loc Groups}"
                               Style="{StaticResource SubtleTextStyle}"
                               Margin="4,0,0,6" />

                    <ListBox x:Name="GroupList"
                             Grid.Row="1"
                             ItemsSource="{Binding Groups}"
                             SelectedItem="{Binding SelectedGroup, Mode=TwoWay}"
                             DisplayMemberPath="Name"
                             AllowDrop="True"
                             ToolTip="{res:Loc DragToReorderHint}"
                             AutomationProperties.Name="{res:Loc Groups}"
                             PreviewMouseLeftButtonDown="OnGroupListPreviewMouseLeftButtonDown"
                             PreviewMouseLeftButtonUp="OnGroupListPreviewMouseLeftButtonUp"
                             PreviewMouseMove="OnGroupListPreviewMouseMove"
                             DragOver="OnGroupListDragOver"
                             DragLeave="OnGroupListDragLeave"
                             Drop="OnGroupListDrop" />

                    <WrapPanel Grid.Row="2" Margin="0,8,0,0">
                        <Button Content="{res:Loc AddGroup}"
                                Command="{Binding AddGroupCommand}"
                                Margin="0,0,6,0" />
                        <Button Content="{res:Loc DeleteGroup}"
                                Command="{Binding DeleteGroupCommand}" />
                    </WrapPanel>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="{res:Loc GroupName}"
                                   Style="{StaticResource SubtleTextStyle}" />

                        <TextBox Grid.Row="1"
                                 Text="{Binding SelectedGroup.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,4,0,0" />

                        <StackPanel Grid.Row="2"
                                    Orientation="Horizontal"
                                    Margin="0,8,0,0">
                            <Button x:Name="IconPickerButton"
                                    Command="{Binding OpenIconPickerCommand}"
                                    Width="40"
                                    Height="40"
                                    Padding="0"
                                    Margin="0,0,8,0"
                                    ToolTip="{res:Loc BuiltInIcon}"
                                    AutomationProperties.Name="{res:Loc BuiltInIcon}">
                                <Image Source="{Binding SelectedGroup.IconSource}"
                                       Width="28"
                                       Height="28"
                                       Stretch="Uniform" />
                            </Button>

                            <Popup x:Name="IconPickerPopup"
                                   IsOpen="{Binding IsIconPickerOpen, Mode=TwoWay}"
                                   PlacementTarget="{Binding ElementName=IconPickerButton}"
                                   Placement="Bottom"
                                   StaysOpen="False"
                                   AllowsTransparency="True"
                                   DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                <Border Style="{StaticResource CardBorderStyle}" Padding="8">
                                    <StackPanel>
                                        <TextBlock Text="{res:Loc IconColorFollowsTheme}"
                                                   Style="{StaticResource SubtleTextStyle}"
                                                   Margin="4,0,4,6" />
                                        <ScrollViewer MaxHeight="480"
                                                      VerticalScrollBarVisibility="Auto"
                                                      HorizontalScrollBarVisibility="Disabled">
                                            <ItemsControl ItemsSource="{Binding IconThemeGroups}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="4,0,4,8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Name}"
                                                                       FontWeight="SemiBold"
                                                                       VerticalAlignment="Center"
                                                                       MinWidth="48"
                                                                       Margin="0,0,8,0" />
                                                            <ItemsControl Grid.Column="1"
                                                                          ItemsSource="{Binding Icons}">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <UniformGrid Columns="10" />
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Button Style="{StaticResource IconChoiceButtonStyle}"
                                                                                Width="40"
                                                                                Height="40"
                                                                                Command="{Binding DataContext.SelectBuiltInIconCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}, AncestorLevel=2}}"
                                                                                CommandParameter="{Binding}"
                                                                                ToolTip="{Binding Name}"
                                                                                AutomationProperties.Name="{Binding Name}">
                                                                            <Image Source="{Binding ImageSource}"
                                                                                   Width="26"
                                                                                   Height="26"
                                                                                   Stretch="Uniform" />
                                                                        </Button>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </StackPanel>
                                </Border>
                            </Popup>

                            <Button x:Name="ThemePickerButton"
                                    Command="{Binding OpenThemePickerCommand}"
                                    Width="40"
                                    Height="40"
                                    Padding="0"
                                    ToolTip="{res:Loc ThemeColor}"
                                    AutomationProperties.Name="{res:Loc ThemeColor}">
                                <Grid Width="28" Height="28">
                                    <Border CornerRadius="6"
                                            BorderThickness="1"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            Background="{Binding SelectedGroup.ThemePreviewBrush}" />
                                    <Path Data="M 3,3 L 25,25"
                                          Stroke="{DynamicResource SubtleTextBrush}"
                                          StrokeThickness="2">
                                        <Path.Style>
                                            <Style TargetType="Path">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedGroup.IsThemeNone}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Path.Style>
                                    </Path>
                                </Grid>
                            </Button>

                            <Popup x:Name="ThemePickerPopup"
                                   IsOpen="{Binding IsThemePickerOpen, Mode=TwoWay}"
                                   PlacementTarget="{Binding ElementName=ThemePickerButton}"
                                   Placement="Bottom"
                                   StaysOpen="False"
                                   AllowsTransparency="True"
                                   DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                <Border Style="{StaticResource CardBorderStyle}" Padding="8">
                                    <ItemsControl ItemsSource="{Binding ThemeColorOptions}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel MaxWidth="276" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource IconChoiceButtonStyle}"
                                                        Width="40"
                                                        Height="40"
                                                        Command="{Binding DataContext.SelectThemeColorCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                                        CommandParameter="{Binding}"
                                                        AutomationProperties.Name="{Binding Name}">
                                                    <Grid Width="24" Height="24">
                                                        <Border CornerRadius="5"
                                                                BorderThickness="1"
                                                                BorderBrush="{DynamicResource BorderBrush}"
                                                                Background="{Binding PreviewBrush}" />
                                                        <Path Data="M 2,2 L 22,22"
                                                              Stroke="{DynamicResource SubtleTextBrush}"
                                                              StrokeThickness="2">
                                                            <Path.Style>
                                                                <Style TargetType="Path">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsNone}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Path.Style>
                                                        </Path>
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                            </Popup>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="2" Margin="0,4,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="{res:Loc GroupItems}"
                                   Style="{StaticResource SubtleTextStyle}"
                                   VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="{res:Loc ImportStartMenu}"
                                    Command="{Binding ImportStartMenuCommand}"
                                    Margin="0,0,6,0" />
                            <Button Content="{res:Loc AddFile}"
                                    Command="{Binding AddFileCommand}"
                                    Margin="0,0,6,0" />
                            <Button Content="{res:Loc AddUrl}"
                                    Command="{Binding AddUrlCommand}" />
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="3" Style="{StaticResource CardBorderStyle}" Background="{DynamicResource SurfaceAltBrush}" Padding="4">
                        <ListBox ItemsSource="{Binding SelectedGroup.Items}"
                                 SelectedItem="{Binding SelectedItem, Mode=TwoWay}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid ToolTip="{Binding ToolTip}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Image Grid.Column="0"
                                               Source="{Binding IconSource}"
                                               Width="24"
                                               Height="24"
                                               Stretch="Uniform"
                                               Margin="0,0,10,0" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}"
                                                       TextTrimming="CharacterEllipsis"
                                                       TextWrapping="NoWrap" />
                                            <TextBlock Text="{Binding Target}"
                                                       Style="{StaticResource SubtleTextStyle}"
                                                       TextTrimming="CharacterEllipsis"
                                                       TextWrapping="NoWrap" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>

                    <WrapPanel Grid.Row="4" Margin="0,8,0,0">
                        <Button Content="{res:Loc Remove}"
                                Command="{Binding RemoveItemCommand}"
                                Margin="0,0,6,0" />
                        <Button Content="{res:Loc Rename}"
                                Command="{Binding RenameItemCommand}"
                                Margin="0,0,6,0" />
                        <Button Content="{res:Loc MoveUp}"
                                Command="{Binding MoveItemUpCommand}"
                                Margin="0,0,6,0" />
                        <Button Content="{res:Loc MoveDown}"
                                Command="{Binding MoveItemDownCommand}" />
                    </WrapPanel>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="4">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource StatusBannerStyle}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsStatusVisible}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel Orientation="Horizontal">
                <TextBlock VerticalAlignment="Center"
                           FontSize="14"
                           FontWeight="Bold"
                           Margin="0,0,8,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                            <Setter Property="Text" Value="i" />
                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StatusKind}" Value="Success">
                                    <Setter Property="Text" Value="✓" />
                                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding StatusKind}" Value="Error">
                                    <Setter Property="Text" Value="!" />
                                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
