    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#F7F7F7" />
    <SolidColorBrush x:Key="TextBrush" Color="#1A1A1A" />
    <SolidColorBrush x:Key="SubtleTextBrush" Color="#616161" />
