<Project>

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <LangVersion>latest</LangVersion>
    <Version>1.12.2</Version>
    <AssemblyVersion>1.7.0.0</AssemblyVersion>
    <FileVersion>1.12.2.0</FileVersion>
    <Copyright>Copyright © 2026 Mark (mark216tw)</Copyright>
    <PublishReadyToRun Condition="'$(Configuration)' == 'Release' and '$(RuntimeIdentifier)' != ''">true</PublishReadyToRun>
    <Product>TaskbarFolders</Product>
    <Authors>Mark</Authors>
    <Company>Mark</Company>
    <NeutralLanguage>zh-TW</NeutralLanguage>
  </PropertyGroup>

</Project>
